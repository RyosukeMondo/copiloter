{
    "manifest_version": 3,
    "name": "Copiloter",
    "version": "1.0.0",
    "description": "Capture Microsoft Copilot conversations",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "https://copilot.microsoft.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://copilot.microsoft.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}